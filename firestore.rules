rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Profils utilisateurs
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid != userId;
    }

    // 2. Boutiques
    match /stores/{storeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false; // Jamais effaçable
    }

    // 3. Stocks de fruits
    match /fruits/{fruitId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 4. Ventes
    match /sales/{saleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 5. Règlements de dettes
    match /repayments/{repId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // 6. Historique (Audit immuable)
    match /history/{histId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Jamais effaçable ni modifiable
    }
  }
}
