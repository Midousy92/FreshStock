rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMember(storeId) {
      return hasProfile() && getUser().storeId == storeId;
    }

    function isAdmin() {
      return hasProfile() && getUser().role == 'admin';
    }

    // 1. Profils utilisateurs
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || (hasProfile() && getUser().storeId == resource.data.storeId));
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && ((request.auth.uid == userId && request.resource.data.role == resource.data.role) || (isAdmin() && getUser().storeId == resource.data.storeId));
      allow delete: if isAdmin() && request.auth.uid != userId && getUser().storeId == resource.data.storeId;
    }

    // 2. Boutiques
    match /stores/{storeId} {
      allow read: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isMember(storeId));
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid && request.resource.data.plan == resource.data.plan;
      allow delete: if false;
    }

    // 3. Stocks de fruits
    match /fruits/{fruitId} {
      allow read: if isSignedIn() && isMember(resource.data.storeId);
      allow create: if isSignedIn() && isMember(request.resource.data.storeId) && isAdmin();
      allow update: if isSignedIn() && isMember(resource.data.storeId);
      allow delete: if isSignedIn() && isMember(resource.data.storeId) && isAdmin();
    }

    // 4. Ventes
    match /sales/{saleId} {
      allow read: if isSignedIn() && isMember(resource.data.storeId);
      allow create: if isSignedIn() && isMember(request.resource.data.storeId);
      allow update, delete: if isSignedIn() && isMember(resource.data.storeId) && isAdmin();
    }

    // 5. Règlements de dettes
    match /repayments/{repId} {
      allow read: if isSignedIn() && isMember(resource.data.storeId);
      allow create: if isSignedIn() && isMember(request.resource.data.storeId);
      allow update, delete: if isSignedIn() && isMember(resource.data.storeId) && isAdmin();
    }

    // 6. Historique (Audit)
    match /history/{histId} {
      allow read: if isSignedIn() && isMember(resource.data.storeId);
      allow create: if isSignedIn() && isMember(request.resource.data.storeId);
      allow update, delete: if false;
    }
  }
}
